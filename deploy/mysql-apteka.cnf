# /etc/mysql/mysql.conf.d/99-apteka.cnf
# Под 1 ГБ памяти VPS. База маленькая (2 ГБ в год), этого хватит с запасом.

[mysqld]
bind-address = 127.0.0.1
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 1
max_connections = 50
performance_schema = OFF
skip-name-resolve
